# Invention Index 8 — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Database ──
POSTGRES_PASSWORD=secret

# ── Auth ──
AUTH_SECRET_KEY=generate-a-random-secret-key
MAGIC_LINK_BASE_URL=http://localhost:3000

# ── Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=hello@inventionindex8.com
EMAIL_DEV_RECIPIENT=you@example.com
EMAIL_SEND_MODE=dev
# Only set to true when you are sending real emails to real users:
# EMAIL_PRODUCTION_ACKNOWLEDGED=true

# ── LLM ──
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── Stripe (TEST MODE ONLY) ──
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BASIC=price_xxxxxxxx
STRIPE_PRICE_ID_LIFETIME=price_xxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxxxx

# ── Sentry ──
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxxx

# ── Patent Data Sources ──
USPTO_API_KEY=xxxxxxxxxxxxxxxx
EPO_OPS_CLIENT_ID=xxxxxxxxxxxxxxxx
EPO_OPS_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_CLOUD_PROJECT=your-project-id
# Path to GCP service account JSON on the HOST (mounted into container):
# GOOGLE_APPLICATION_CREDENTIALS_HOST=/Users/you/Downloads/patent-signals-xxx.json

# ── Backup (optional) ──
# BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# BACKUP_S3_BUCKET=patent-pulse-backups
# BACKUP_S3_ACCESS_KEY=xxxxxxxxxxxxxxxx
# BACKUP_S3_SECRET_KEY=xxxxxxxxxxxxxxxx
# BACKUP_RETENTION_DAYS=30

# ── Environment ──
ENVIRONMENT=development
RELEASE_SHA=
