# Database
POSTGRES_PASSWORD=secret

# APIs - Required for Phase 1
ANTHROPIC_API_KEY=sk-ant-your-key-here
USPTO_API_KEY=your-uspto-api-key

# APIs - Required for Phase 2 (EPO)
# Register at: https://developers.epo.org/
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=

# APIs - Optional (BigQuery historical backfill)
GOOGLE_CLOUD_PROJECT=

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CLAUDE_MODEL=claude-sonnet-4-20250514

# Summarization
SUMMARIZATION_BATCH_SIZE=10
MAX_SUMMARY_RETRIES=3
INGEST_LOOKBACK_DAYS=7

# Weekly ingestion schedule (in America/New_York timezone)
# USPTO Grants: Tuesday 10:00 AM
# USPTO Applications: Thursday 10:00 AM
# EPO Publications: Wednesday 12:00 PM
# WIPO PCT: Thursday 2:00 PM
# Family Resolution: Friday 6:00 AM
