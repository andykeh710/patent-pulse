# ============================================================================
# Patent Pulse environment configuration
# Copy this file to ".env" and fill in your credentials.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
POSTGRES_PASSWORD=secret

# ----------------------------------------------------------------------------
# REQUIRED — Anthropic Claude (LLM for summaries, tagging, narratives)
# Get a key at: https://console.anthropic.com/
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ----------------------------------------------------------------------------
# REQUIRED for fresh ingestion — USPTO API
# Get a key at: https://developer.uspto.gov/api-catalog
# Not needed if you are restoring from a database dump and not re-ingesting.
# ----------------------------------------------------------------------------
USPTO_API_KEY=your-uspto-api-key

# ----------------------------------------------------------------------------
# OPTIONAL — EPO Open Patent Services (European patent enrichment)
# Register at: https://developers.epo.org/
# If blank, EPO ingestion and family resolution are skipped.
# ----------------------------------------------------------------------------
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# OPTIONAL — Google BigQuery historical patent backfill
# Leave blank unless you intend to run multi-year backfills.
# ----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=

# ----------------------------------------------------------------------------
# App settings
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Claude models (defaults pinned to a known-good tier).
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_HAIKU_MODEL=claude-haiku-4-5

# LLM cache behavior:
#   live   -> always call the API (also writes to cache)
#   record -> call API only on cache miss, write to cache
#   replay -> never call API, raise on cache miss (deterministic dev mode)
LLM_MODE=record

# Cost guardrails for /admin/ai-runs.
LLM_RUN_AUTO_APPROVE_USD=5.0
LLM_RUN_FULL_BATCH_THRESHOLD_USD=25.0

# Ingestion behavior
SUMMARIZATION_BATCH_SIZE=10
MAX_SUMMARY_RETRIES=3
INGEST_LOOKBACK_DAYS=7
BIGQUERY_BACKFILL_YEARS=5

# Single-user scaffold (no auth yet).
SINGLE_USER_MODE=true
DEFAULT_USER_ID=local-user
DEFAULT_USER_DISPLAY_NAME=Local User

# ----------------------------------------------------------------------------
# Weekly Celery beat schedule (America/New_York)
#   USPTO Grants:        Tue 10:00 AM
#   USPTO Applications:  Thu 10:00 AM
#   EPO Publications:    Wed 12:00 PM
#   WIPO PCT:            Thu 2:00 PM
#   Family Resolution:   Fri 6:00 AM
#   Enrich Abstracts:    Sat 8:00 PM
#   Summarization:       Sun 2:00 AM
#   Embeddings:          Sun 4:00 AM
#   Trend Snapshots:     Sun 7:00 AM
#   Cliff Clusters:      Sun 7:30 AM
#   Convergence:         Sun 8:00 AM
#   Expiry Watch:        Daily 6:00 AM
# ----------------------------------------------------------------------------
